{
  "description": "Researcher specialist that use multiple mcp tools for factual research.",
  "pi": {
    "name": "factual-researcher",
    "model": "cpa/gemini-3.8-flash",
    "systemPromptMode": "replace",
    "defaultContext": "fresh",
    "inheritProjectContext": "false",
    "inheritSkills": "false",
    "skills": "factual-research, firecrawl, firecrawl-crawl, firecrawl-map, firecrawl-parse, firecrawl-scrape, firecrawl-search",
    "tools": "@inspect, safe_bash, @docs, mcp:firecrawl, @web, contact_supervisor"
  },
  "codex": {
    "name": "factual-researcher",
    "model": "gpt-6-luna",
    "model_reasoning_effort": "xhigh",
    "sandbox_mode": "read-only",
    "skills": {
      "config": [
        {
          "path": "${paths.factualResearchSkill}",
          "enabled": true
        }
      ]
    },
    "mcp_servers": {
      "context7": {
        "url": "https://mcp.context7.com/mcp"
      },
      "deepwiki": {
        "url": "https://mcp.deepwiki.com/mcp"
      },
      "exa": {
        "url": "https://mcp.exa.ai/mcp"
      },
      "firecrawl-mcp": {
        "command": "npx",
        "args": ["-y", "firecrawl-mcp"],
        "env_vars": ["FIRECRAWL_API_KEY"]
      }
    }
  },
  "vscode": {
    "model": [
      "Gemini 3.7 Flash (Antigravity) (customendpoint)",
      "Mimo-2.5 (OCG) (customendpoint)",
      "Mimo 2.5 Free (Zen) (customendpoint)",
      "DeepSeek: DeepSeek V4 Flash 0731 (openrouter)"
    ],
    "tools": ["context7/*", "exa/*", "firecrawl/*", "web", "search", "read", "todo"]
  },
  "antigravity": {
    "name": "factual-researcher",
    "mainAgent": true,
    "subagent": true,
    "inheritMcp": true,
    "model": "flash",
    "commandExecutionPolicy": "off",
    "tools": [
      "view_file",
      "grep_search",
      "find_by_name",
      "list_dir",
      "search_web",
      "read_url_content"
    ]
  },
  "opencode": {
    "mode": "subagent",
    "permissions": [
      {
        "action": "edit",
        "resource": "*",
        "effect": "deny"
      }
    ]
  }
}
