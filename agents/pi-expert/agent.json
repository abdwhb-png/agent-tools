{
  "description": "Authoritative expert on the `pi` agent harness, its architecture, extensions, and skills.",
  "pi": {
    "name": "pi-expert",
    "model": "cpa/gemini-3.8-flash",
    "thinking": "high",
    "defaultContext": "fresh",
    "inheritProjectContext": "false",
    "inheritSkills": "false",
    "skills": "pi-extensions, factual-research",
    "tools": "@inspect, @lens-inspect, @docs, @web, @pi-session-recall, safe_bash, contact_supervisor"
  },
  "codex": {
    "name": "pi-expert",
    "model": "gpt-6-sol",
    "model_reasoning_effort": "low",
    "sandbox_mode": "read-only",
    "nickname_candidates": ["Pi Expert"],
    "mcp_servers": {
      "pi-session-recall": {
        "command": "node",
        "args": ["${paths.piSessionRecallScript}", "--project-dir", "${paths.piProjectDir}"],
        "default_tools_approval_mode": "approve"
      }
    }
  },
  "vscode": {
    "name": "pi-expert",
    "model": [
      "Gemini 3.7 Flash (Antigravity) (customendpoint)",
      "Claude Sonnet 4.6 Thinking (Antigravity) (customendpoint)",
      "DeepSeek: DeepSeek V4 Flash 0731 (openrouter)"
    ],
    "tools": [
      "read",
      "search",
      "web",
      "context7/*",
      "deepwiki/*",
      "exa/*",
      "pi-lens/*",
      "pi-session-recall/*"
    ]
  },
  "antigravity": {
    "name": "pi-expert",
    "mainAgent": true,
    "subagent": true,
    "inheritMcp": true,
    "model": "pro",
    "commandExecutionPolicy": "off",
    "tools": [
      "view_file",
      "grep_search",
      "find_by_name",
      "code_search",
      "list_dir",
      "search_web",
      "read_url_content"
    ],
    "mcpServers": [
      {
        "name": "pi-session-recall",
        "command": "node",
        "args": ["${paths.piSessionRecallScript}", "--project-dir", "${paths.piProjectDir}"]
      }
    ]
  }
}
