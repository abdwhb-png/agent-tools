{
  "description": "Interactive CLI testing specialist",
  "pi": {
    "name": "qa-tester",
    "model": "cpa/muse-spark-1.3-contributor",
    "thinking": "xhigh",
    "tools": "@inspect, @lens-inspect, safe_bash, write_report",
    "systemPromptMode": "replace",
    "inheritProjectContext": "true",
    "inheritSkills": "false",
    "defaultContext": "fresh"
  },
  "codex": {
    "name": "qa-tester",
    "model": "gpt-6.1-terra",
    "model_reasoning_effort": "xhigh",
    "sandbox_mode": "workspace-write",
    "approval_policy": "never"
  },
  "vscode": {
    "name": "qa-tester",
    "argument-hint": "Task description.",
    "tools": [
      "read",
      "search",
      "execute/getTerminalOutput",
      "execute/killTerminal",
      "execute/runInTerminal",
      "execute/sendToTerminal",
      "todo"
    ],
    "model": [
      "GPT 5.6 Luna (Openai-codex) (customendpoint)",
      "DeepSeek V4 Flash (Go) (customendpoint)",
      "DeepSeek: DeepSeek V4 Flash 0731 (openrouter)"
    ]
  },
  "antigravity": {
    "name": "qa-tester",
    "mainAgent": true,
    "subagent": true,
    "inheritMcp": false,
    "model": "pro",
    "commandExecutionPolicy": "sandbox",
    "tools": [
      "view_file",
      "grep_search",
      "find_by_name",
      "code_search",
      "list_dir",
      "run_command",
      "manage_task",
      "ask_question"
    ]
  },
  "opencode": {
    "mode": "subagent",
    "permissions": [
      {
        "action": "edit",
        "resource": "*",
        "effect": "deny"
      }
    ]
  }
}
