{
  "description": "Expert code review specialist with severity-rated feedback - (READ ONLY)",
  "pi": {
    "name": "code-reviewer",
    "model": "openai-codex/gpt-6.1-sol",
    "thinking": "xhigh",
    "tools": "@review-max, @subagents",
    "allowedAgents": "qa-tester"
  },
  "codex": {
    "name": "code-reviewer",
    "model": "gpt-6.1-sol",
    "model_reasoning_effort": "xhigh",
    "sandbox_mode": "read-only"
  },
  "vscode": {
    "name": "Code Reviewer",
    "model": [
      "GPT 5.6 Sol (Openai-codex) (customendpoint)",
      "Z.ai: GLM 5.2 (openrouter)",
      "DeepSeek V4 Pro (Go) (customendpoint)"
    ],
    "tools": [
      "read",
      "search",
      "agent",
      "web/githubRepo",
      "web/githubTextSearch",
      "context7/*",
      "deepwiki/*"
    ],
    "agents": [
      "Scout",
      "Architect",
      "qa-tester"
    ]
  },
  "antigravity": {
    "name": "code-reviewer",
    "mainAgent": true,
    "subagent": true,
    "inheritMcp": true,
    "model": "pro",
    "commandExecutionPolicy": "off",
    "tools": [
      "view_file",
      "grep_search",
      "find_by_name",
      "code_search",
      "list_dir",
      "read_url_content",
      "invoke_subagent",
      "manage_subagents",
      "ask_question"
    ]
  },
  "opencode": {
    "mode": "subagent",
    "permissions": [
      {
        "action": "edit",
        "resource": "*",
        "effect": "deny"
      }
    ]
  }
}
