{
  "description": "Strict bounded implementation worker for small, explicit, reversible tasks with an exact file allowlist and focused verification.",
  "pi": {
    "name": "quick-worker",
    "model": "cpa/ocg/go-deepseek-v4.1-flash",
    "tools": "@inspect, @lens-inspect, @lens-write, @implement",
    "thinking": "medium",
    "systemPromptMode": "replace",
    "inheritProjectContext": "true",
    "inheritSkills": "false",
    "defaultContext": "fresh",
    "turnBudget": "{ \"maxTurns\": 20, \"graceTurns\": 5 }",
    "acceptanceRole": "writer"
  },
  "codex": {
    "name": "quick-worker",
    "model": "gpt-6-sol",
    "model_reasoning_effort": "low",
    "sandbox_mode": "workspace-write"
  },
  "vscode": {
    "name": "quick-worker",
    "tools": [
      "read",
      "edit",
      "search",
      "todo",
      "execute/getTerminalOutput",
      "execute/killTerminal",
      "execute/runInTerminal",
      "execute/sendToTerminal",
      "pi-lens/*"
    ],
    "model": [
      "Mimo-2.5 (OCG) (customendpoint)",
      "Gemini 3.7 Flash (Antigravity) (customendpoint)",
      "GPT 5.6 Luna (Openai-codex) (customendpoint)",
      "DeepSeek: DeepSeek V4 Flash 0731 (openrouter)"
    ],
    "agents": []
  },
  "antigravity": {
    "name": "quick-worker",
    "mainAgent": true,
    "subagent": true,
    "inheritMcp": false,
    "model": "flash",
    "commandExecutionPolicy": "sandbox",
    "tools": [
      "view_file",
      "write_to_file",
      "replace_file_content",
      "multi_replace_file_content",
      "list_dir",
      "find_by_name",
      "grep_search",
      "code_search",
      "run_command",
      "manage_task"
    ]
  }
}
