{
  "schemaVersion": 1,
  "harnesses": {
    "pi": {
      "enabled": true,
      "agentDir": "/absolute/path/to/.pi/agent"
    },
    "codex": {
      "enabled": true,
      "home": "/absolute/path/to/.codex",
      "additionalHomes": [
        { "id": "windows", "home": "/mnt/c/Users/example/.codex" }
      ]
    },
    "vscode": {
      "enabled": true,
      "targets": [
        "/absolute/path/to/Code/User/instructions/agent-policy.instructions.md",
        "/absolute/path/to/.copilot/instructions/agent-policy.instructions.md"
      ]
    },
    "zed": {
      "enabled": true,
      "home": "/mnt/c/Users/example/AppData/Roaming/Zed",
      "additionalHomes": [
        { "id": "linux", "home": "/home/example/.config/zed" }
      ]
    }
  }
}
