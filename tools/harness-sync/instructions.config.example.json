{
  "schemaVersion": 2,
  "kind": "instructions",
  "enabled": true,
  "skills": {
    "enabled": false,
    "source": "/home/example/.agents/skills",
    "targets": [
      {
        "id": "antigravity",
        "path": "/home/example/.gemini/config/skills"
      }
    ]
  },
  "harnesses": {
    "pi": { "enabled": true, "agentDir": "/absolute/path/to/.pi/agent" },
    "codex": {
      "enabled": true,
      "home": "/absolute/path/to/.codex",
      "additionalHomes": [{ "id": "windows", "home": "/mnt/c/Users/example/.codex" }]
    },
    "vscode": {
      "enabled": true,
      "targets": [
        "/absolute/path/to/Code/User/instructions/agent-policy.instructions.md",
        "/absolute/path/to/.copilot/instructions/agent-policy.instructions.md"
      ]
    },
    "zed": {
      "enabled": false,
      "home": "/mnt/c/Users/example/AppData/Roaming/Zed",
      "additionalHomes": [{ "id": "linux", "home": "/home/example/.config/zed" }]
    },
    "antigravity": {
      "enabled": false,
      "home": "/home/example/.gemini",
      "additionalHomes": [{ "id": "windows", "home": "/mnt/c/Users/example/.gemini" }]
    }
  }
}
